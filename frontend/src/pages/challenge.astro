---
import MainLayout from '../layouts/MainLayout.astro';

---

<MainLayout title="Challenge">

	<section id="challenge" class="mt-16 max-w-6xl w-full h-full flex flex-col justify-center items-center md:justify-between md:flex-row md:min-h-[80vh]">
		<div class="text-primary-100 max-w-xl flex flex-col text-center justify-center gap-8 px-8 md:text-start md:justify-start" transition:name="title-section">
			<h1 class="font-bold text-4xl xs:text-5xl md:text-6xl" data-section="challenge" data-value="title">NASA SPACE APPS CHALLENGE</h1>
			<p class="text-md xs:text-lg" data-section="challenge" data-value="paragraph">Explore the fascinating dynamics of asteroids with our interactive simulator.</p>
			<a href="https://www.spaceappschallenge.org/" target="_blank" class="text-primarytext-100 px-2 py-2 w-56 self-center text-center rounded-lg bg-primary-500 hover:bg-primary-600 cursor-pointer md:self-start" data-section="challenge" data-value="btn">Start Simulation</a>
		</div>
		<img src="nasa_logo.png" alt="Asteroid" class="md:overflow-hidden md:max-w-[600px]"/>
	</section>

</MainLayout>

---
import MainLayout from '../layouts/MainLayout.astro';

---

<MainLayout title="Team">
	
	<section id="team" class="max-w-6xl w-full h-full flex flex-col justify-between items-center py-8 md:flex-row-reverse">
		<div class="text-primarytext-100 max-w-xl max-h-80 h-full flex flex-col text-center md:text-end justify-start gap-8 pt-8 p-8" transition:name="title-h1-section">
			<h1 class="font-bold text-6xl" data-section="team" data-value="title" >Team JJBC</h1>
			<p class="text-lg" data-section="team" data-value="paragraph">We are Team JJBC — a group of three creators passionate about building interactive tools and simulators that make complex ideas easy to explore and understand.</p>
		</div>
		
		<div class="max-w-xl flex flex-col gap-8 text-primarytext-100">
			<div class="flex flex-col sm:flex-row gap-8 w-full">
				<!-- Integrante 1 -->
				<div class="flex flex-col items-center text-center gap-4 w-[220px]">
					<div class="w-32 h-32 rounded-full flex items-center justify-center overflow-hidden border">
						<img src="/path/to/photo1.jpg" alt="Juan" class="w-full h-full object-cover">
					</div>
					<h3 class="font-semibold text-xl">Cordeiro Mariano</h3>
					<p class="text-md" >Developer</p>
				</div>

				<!-- Integrante 2 -->
				<div class="flex flex-col items-center text-center gap-4 w-[220px]">
					<div class="w-32 h-32 rounded-full flex items-center justify-center overflow-hidden border">
						<img src="/path/to/photo2.jpg" alt="Julia" class="w-full h-full object-cover">
					</div>
					<h3 class="font-semibold text-xl">Blanco Facundo</h3>
					<p class="text-md" >Developer</p>
				</div>
			</div>

			<!-- Integrante 3 -->
			<div class="flex flex-col items-center self-center text-center gap-4 w-[220px]">
				<div class="w-32 h-32 rounded-full flex items-center justify-center overflow-hidden border">
					<img src="/path/to/photo3.jpg" alt="Bruno" class="w-full h-full object-cover">
				</div>
				<h3 class="font-semibold text-xl">Medina Gabriel</h3>
				<p class="text-md">Developer</p>
			</div>
		</div>

		

	</section>

</MainLayout>

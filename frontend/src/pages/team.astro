---
import MainLayout from '../layouts/MainLayout.astro';

---

<MainLayout title="Team">
	
	<section id="team" class="mt-8 mb-16 px-8 max-w-6xl w-full h-full flex flex-col justify-between items-center lg:flex-row-reverse md:justify-between lg:mt-16">
		<div class="text-primary-100 max-w-xl pl-8 lg:justify-start max-h-80 h-full flex flex-col text-center lg:text-end justify-start gap-8 p-8" transition:name="title-section">
			<h1 class="font-bold text-4xl xs:text-5xl md:text-6xl" data-section="team" data-value="title" >TEAM JJBC</h1>
			<p class="text-md xs:text-lg" data-section="team" data-value="paragraph">We are Team JJBC — a group of three creators passionate about building interactive tools and simulators that make complex ideas easy to explore and understand.</p>
		</div>
		
	<div class="bg-[#181F2A] w-full flex flex-col items-center gap-8 rounded-xl p-8 md:flex-col lg:max-x-2xl border border-[#05070D]">
			<div class="flex flex-col gap-8">
				<div class="flex flex-row gap-8 justify-center">
					<!-- Integrante 1 -->
					<div class="flex flex-col items-center text-center gap-4 w-[220px] text-white">
						<div class="w-32 h-32 rounded-full flex items-center justify-center overflow-hidden border">
							<img src="/path/to/photo1.jpg" alt="Juan" class="w-full h-full object-cover">
						</div>
						<h3 class="font-semibold text-xl text-[var(--color-primary-300)]" data-section="team" data-value="dev1">Cordeiro Mariano</h3>
						<p class="text-md text-gray-300" data-section="team" data-value="developer">Developer</p>
					</div>
					<!-- Integrante 2 -->
					<div class="flex flex-col items-center text-center gap-4 w-[220px] text-white">
						<div class="w-32 h-32 rounded-full flex items-center justify-center overflow-hidden border">
							<img src="/path/to/photo2.jpg" alt="Julia" class="w-full h-full object-cover">
						</div>
						<h3 class="font-semibold text-xl text-[var(--color-primary-300)]" data-section="team" data-value="dev2">Blanco Facundo</h3>
						<p class="text-md text-gray-300" data-section="team" data-value="developer">Developer</p>
					</div>
				</div>
				<div class="flex flex-row gap-8 justify-center">
					<!-- Integrante 3 -->
					<div class="flex flex-col items-center text-center gap-4 w-[220px] text-white">
						<div class="w-32 h-32 rounded-full flex items-center justify-center overflow-hidden border">
							<img src="/path/to/photo3.jpg" alt="Bruno" class="w-full h-full object-cover">
						</div>
						<h3 class="font-semibold text-xl text-[var(--color-primary-300)]" data-section="team" data-value="dev3">Medina Gabriel</h3>
						<p class="text-md text-gray-300" data-section="team" data-value="developer">Developer</p>
					</div>
					<!-- Integrante 4 -->
					<div class="flex flex-col items-center text-center gap-4 w-[220px] text-white">
						<div class="w-32 h-32 rounded-full flex items-center justify-center overflow-hidden border">
							<img src="/path/to/photo4.jpg" alt="Jeronimo" class="w-full h-full object-cover">
						</div>
						<h3 class="font-semibold text-xl text-[var(--color-primary-300)]">Jeronimo Journade</h3>
						<p class="text-md text-gray-300">Developer</p>
					</div>
					<!-- Integrante 5 -->
					<div class="flex flex-col items-center text-center gap-4 w-[220px] text-white">
						<div class="w-32 h-32 rounded-full flex items-center justify-center overflow-hidden border">
							<img src="/path/to/photo5.jpg" alt="Anush" class="w-full h-full object-cover">
						</div>
						<h3 class="font-semibold text-xl text-[var(--color-primary-300)]">Anush Gullerian</h3>
						<p class="text-md text-gray-300">UX/UI Designer</p>
					</div>
				</div>
			</div>
		</div>

	
	</section>


</MainLayout>

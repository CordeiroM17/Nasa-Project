---
import MainLayout from '../layouts/MainLayout.astro';
import Map from '../components/Map.astro';
import { API_URL } from 'astro:env/server';

let asteroid: any[] = [];

async function getAsteroids() {
    try {
        const res = await fetch(`${API_URL}/meteors`);
        const asteroids = await res.json();
        
        if (res && asteroids.code === 200) {
            asteroid = asteroids.data;
            console.log(asteroids.message)
            console.log("Asteroid data Loaded")
        } else {
            throw new Error(asteroids.message);
        }
    } catch (error) {
        console.error("Error fetching asteroid data:", error);
    }
}

await getAsteroids();
---

<MainLayout title="Asteroid Simulation">
    <section id="simulation" class="w-full flex items-start h-[80vh]">

        <!-- Menú lateral, abierto por defecto -->
        <div id="sideMenuParameters" class="max-w-md fixed md:static w-full h-full flex flex-col justify-between text-center gap-8 p-8 border-r border-black bg-[#F7F4ED] top-0 left-0 z-50 transform translate-x-0 transition-transform duration-300">
            <!-- AGREGAR SELECT DE ASTEROIDES -->
            <div class="flex gap-8">
                <div id="closeMenuParametersBtn" class="p-2 block cursor-pointer top-4 z-50 bg-[#F7F4ED] border border-black rounded-r-lg shadow-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </div>
                <button class="border border-black">AGREGAR SELECT DE ASTEROIDES</button>
            </div>

        <!--  {asteroid.map((meteor) => (
                <div>
                    <h2>{meteor.name}</h2>
                    <h2>{meteor.type}</h2>
                </div>
            ))} -->
            
            <!-- Title section -->
            <div class="rounded-lg border border-black flex flex-col gap-2 text-start p-2">
                <h1 class="font-bold text-lg">Simulation Parameters</h1>
                <p class="text-sm text-[#75818B] font-bold">Adjust the parameters below to customize the asteroid simulation.</p>
            </div>

            <!-- Asteroid parameters -->
            <div class="rounded-lg border border-black h-full font-bold">
                <div class="flex flex-col gap-2 text-start p-2">
                    <label for="asteroid-size">Asteroid Size: 
                    <span id="size-value">50</span> m
                    </label>
                    <input type="range" id="asteroid-size" min="1" max="15000" value="50" />
                </div>

                <div class="flex flex-col gap-2 text-start p-2">
                    <label for="asteroid-speed">Asteroid Speed: 
                    <span id="speed-value">10</span> km/s
                    </label>
                    <input type="range" id="asteroid-speed" min="1" max="80" value="10" />
                </div>

                <div class="flex flex-col gap-2 text-start p-2">
                    <label for="asteroid-impact-angle">Asteroid Impact Angle: 
                    <span id="angle-value">45</span>°
                    </label>
                    <input type="range" id="asteroid-impact-angle" min="0" max="90" value="45" />
                </div>
            </div>

            <!-- Title section -->
            <div class="flex flex-col gap-2">
                <button class="w-full rounded-lg border border-black" id="start-simulation-btn">Start Simulation</button>
                <button class="w-full rounded-lg border border-black">Reset</button>
            </div>
        </div>

        <button id="openMenuParametersBtn"
            class="p-2 block cursor-pointer absolute top-1/2 left-0 z-20 bg-[#F7F4ED] border border-black rounded-r-lg shadow-lg"
            style="transform: translateY(-50%) translateX(-50%);">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary-100" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>

        <div class="w-full h-full">
            <Map/>
        </div>
    </section>
</MainLayout>

<script type="module">

    const API_URL = "http://127.0.0.1:5000/api";

    function initMenu() {
        const openBtn = document.getElementById("openMenuParametersBtn");
        const closeBtn = document.getElementById("closeMenuParametersBtn");
        const sideMenu = document.getElementById("sideMenuParameters");

        if (openBtn && closeBtn && sideMenu ) {
            // Menú abierto por defecto
            sideMenu.classList.remove("-translate-x-full");
            sideMenu.classList.add("translate-x-0");
           

            openBtn.onclick = () => {
                sideMenu.classList.remove("-translate-x-full");
                sideMenu.classList.add("translate-x-0");
                sideMenu.classList.remove("hidden");
            };
            closeBtn.onclick = () => {
                sideMenu.classList.remove("translate-x-0");
                sideMenu.classList.add("-translate-x-full");
                sideMenu.classList.add("hidden");
            };
        }
    }
    
    function initAsteroid2Dparams() {
        const sizeInput = document.getElementById("asteroid-size");
        const speedInput = document.getElementById("asteroid-speed");
        const angleInput = document.getElementById("asteroid-impact-angle");

        const sizeValue = document.getElementById("size-value");
        const speedValue = document.getElementById("speed-value");
        const angleValue = document.getElementById("angle-value");

        if (sizeInput && sizeValue) {
            // Sincroniza valor inicial
            sizeValue.textContent = sizeInput.value;
            sizeInput.addEventListener("input", () => {
                sizeValue.textContent = sizeInput.value;
            });
        }
        if (speedInput && speedValue) {
            speedValue.textContent = speedInput.value;
            speedInput.addEventListener("input", () => {
                speedValue.textContent = speedInput.value;
            });
        }
        if (angleInput && angleValue) {
            angleValue.textContent = angleInput.value;
            angleInput.addEventListener("input", () => {
                angleValue.textContent = angleInput.value;
            });
        }
    }

    async function postStartSimulation() {
        const sizeElem = document.getElementById("size-value");
        const speedElem = document.getElementById("speed-value");
        const angleElem = document.getElementById("angle-value");

        if (!sizeElem || !speedElem || !angleElem) {
            // pop up

            return;
        }

        const sizeValue = sizeElem.innerText;
        const speedValue = speedElem.innerText;
        const angleValue = angleElem.innerText;

        // Obtener lat/lon seleccionados en el mapa
        const lat = window.selectedLat;
        const lng = window.selectedLng;

        if (lat == null || lng == null) {
            Swal.fire({
                title: 'Error!',
                text: 'Do you want to continue',
                icon: 'error',
                confirmButtonText: 'Cool'
            });
            return;
        }

        // Puedes agregar validaciones para los sliders si quieres

        const payload = {
            size: Number(sizeValue),
            speed: Number(speedValue),
            angle: Number(angleValue),
            latitude: lat,
            longitude: lng
        };

        try {
            console.log("Iniciando simulación con payload:", payload);
            const res = await fetch(`${API_URL}/simulate-impact`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });

            const result = await res.json();
            // Maneja la respuesta aquí (mostrar resultado, alerta, etc.)
            console.log(result);
        } catch (error) {
            alert("Error al iniciar la simulación");
            console.error(error);
        }
}

    function initStartSimulationButton() {
        const startBtn = document.getElementById("start-simulation-btn");
        if (startBtn) {
            startBtn.addEventListener("click", () => {
                postStartSimulation();
            });
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        initMenu()
        initAsteroid2Dparams();
        initStartSimulationButton();
    });   

    document.addEventListener("astro:after-swap", () => {
        initMenu()
        initAsteroid2Dparams();
        initStartSimulationButton();
    });
</script>
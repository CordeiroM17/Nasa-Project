---
import MainLayout from '../layouts/MainLayout.astro';

---

<MainLayout title="Home">
	
	<section id="home" class="max-w-6xl w-full h-full flex justify-start items-center">
		<div class="text-primarytext-100 max-w-2xl max-h-80 h-full flex flex-col text-start justify-start gap-8 pt-8 px-8" transition:name="title-h1-section">
			<h1 class="font-bold text-6xl" data-section="home" data-value="title">Asteroid Simulation</h1>
			<p class="text-lg" data-section="home" data-value="paragraph">Explore the fascinating dynamics of asteroids with our interactive simulator. Use your imagination to save the world or see what would happen in a catastrophic scenario. The choice is yours.</p>
			<a href="/asteroid-simulation" class="px-2 py-2 w-56 self-start text-center rounded-2xl bg-[#0C1421] hover:bg-[#1E2939] cursor-pointer" data-section="home" data-value="play-btn">Start Simulation</a>
		</div>
	</section>

</MainLayout>

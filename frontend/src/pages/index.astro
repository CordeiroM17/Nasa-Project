---
import MainLayout from '../layouts/MainLayout.astro';

---

<MainLayout title="Home">
	
	<section id="home" class="max-w-6xl w-full h-full flex justify-center items-center md:justify-start">
		<div class="text-primarytext-100 max-w-2xl flex flex-col text-center justify-center gap-8 p-8 md:text-start md:justify-start" transition:name="title-h1-section">
			<h1 class="font-bold text-4xl xs:text-5xl md:text-6xl" data-section="home" data-value="title">Asteroid Simulation</h1>
			<p class="text-md xs:text-lg" data-section="home" data-value="paragraph">Explore the fascinating dynamics of asteroids with our interactive simulator. Use your imagination to save the world or see what would happen in a catastrophic scenario. The choice is yours.</p>
			<a href="/asteroid-simulation" class="px-2 py-2 w-56 self-center text-center rounded-2xl bg-[#0C1421] hover:bg-[#1E2939] cursor-pointer md:self-start" data-section="home" data-value="play-btn">Start Simulation</a>
		</div>
	</section>

	<!-- <section id="home-banner" class="max-w-6xl w-full h-full flex justify-start items-center">

	</section> -->

</MainLayout>

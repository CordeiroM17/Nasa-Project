<div id="map" class="w-full h-[83vh] z-10"></div>

<script type="module">
    let mapInstance = null;

    function initMap() {
        const mapDiv = document.getElementById('map');
        if (!mapDiv) return;

        // If a map instance already exists, remove it before creating a new one
        if (mapInstance) {
            mapInstance.remove();
            mapInstance = null;
        }

        mapInstance = L.map('map').setView([-27.46784, -58.8344], 10);

        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(mapInstance);

        const markers = [];
        mapInstance.on('click', function(e) {
            const { lat, lng } = e.latlng;

            window.selectedLat = e.latlng.lat;
            window.selectedLng = e.latlng.lng;

            markers.forEach(marker => mapInstance.removeLayer(marker));

            const newMarker = L.marker([lat, lng]).addTo(mapInstance)
                .bindPopup(`Impact zone`)
                .openPopup();
            markers.push(newMarker);
        });
    }

    // astro:page-load runs on initial page load and after every client-side navigation
    document.addEventListener("astro:page-load", initMap);
</script>